# ---------------------------------------------------------------------------
# Copy to .env and edit. As shipped, everything runs on the offline `echo`
# provider: no key, no network, placeholder lesson text.
# A variable set in your real environment wins over this file.
# ---------------------------------------------------------------------------

# Providers: anthropic | ollama | echo | none -------------------------------
# "echo" is a deterministic offline stub. "none" means no model: that role's
# features are switched off in the UI.
SS_LLM_PROVIDER=echo

# Model work is split into two roles. Leave one empty to use SS_LLM_PROVIDER.
#   author — builds outlines, writes lessons, precomputes lenses and FAQs (use a strong model)
#   reader — the ask box, and any lens a course didn't ship with (small model, or none)
SS_AUTHOR_PROVIDER=echo
SS_READER_PROVIDER=echo

# Anthropic ----------------------------------------------------------------
ANTHROPIC_API_KEY=

# Model per tier. Verify current IDs at docs.claude.com/en/docs/about-claude/models
SS_MODEL_QUICK=claude-haiku-4-5
SS_MODEL_DEFAULT=claude-sonnet-4-5
SS_MODEL_COMPLEX=claude-opus-4-5

# Ollama — local models, and Ollama's hosted models, over the same API --------
# Local daemon. Models must be pulled first: `ollama pull qwen2.5:14b`
# Under ~14B, models tend to break the structured JSON the author role needs.
SS_OLLAMA_HOST=http://localhost:11434
SS_OLLAMA_MODEL_QUICK=llama3.2:3b
SS_OLLAMA_MODEL_DEFAULT=qwen2.5:14b
SS_OLLAMA_MODEL_COMPLEX=qwen2.5:32b

# How long Ollama keeps a model resident after a call ("0" unloads at once).
SS_OLLAMA_KEEP_ALIVE=5m

# Cloud models: run `ollama signin` and name a *-cloud model above — the local
# daemon proxies them, and nothing else here changes.
# To skip the daemon and call the hosted endpoint directly, set host and key instead:
# SS_OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=

# Storage ------------------------------------------------------------------
# sqlite | remote
SS_STORAGE_BACKEND=sqlite
SS_DB_PATH=./data/syllabus_studio.db

# Point at another running instance of this app to share courses across machines
# SS_REMOTE_URL=https://courses.example.com
# SS_REMOTE_TOKEN=

# Community catalog of shareable course bundles (a JSON index; see docs/catalog.md)
SS_CATALOG_URL=

# Server -------------------------------------------------------------------
SS_HOST=127.0.0.1
SS_PORT=8000
SS_RELOAD=true
