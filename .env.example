# ---------------------------------------------------------------------------
# Copy to .env and fill in.  Nothing here is read at import time, so the app
# still starts (on the offline provider) with none of it set.
# ---------------------------------------------------------------------------

# Which LLM provider to use: anthropic | ollama | echo
# "echo" is a deterministic offline stub — the whole app runs without a key.
SS_LLM_PROVIDER=anthropic

# Anthropic ----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Model per tier. Verify current IDs at docs.claude.com/en/docs/about-claude/models
SS_MODEL_QUICK=claude-haiku-4-5
SS_MODEL_DEFAULT=claude-sonnet-4-5
SS_MODEL_COMPLEX=claude-opus-4-5

# Ollama — local models, and Ollama's hosted models, over the same API --------
# Local daemon (default). Models must be pulled: `ollama pull qwen2.5:14b`
SS_OLLAMA_HOST=http://localhost:11434
SS_OLLAMA_MODEL_QUICK=llama3.2:3b
SS_OLLAMA_MODEL_DEFAULT=qwen2.5:14b
SS_OLLAMA_MODEL_COMPLEX=qwen2.5:32b

# How long Ollama keeps a model resident after a call ("0" unloads at once).
SS_OLLAMA_KEEP_ALIVE=5m

# Cloud models: run `ollama signin` and name a *-cloud model above — the local
# daemon proxies them, and nothing else here changes. To skip the daemon and
# call the hosted endpoint directly, set the host and a key instead:
# SS_OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=

# Storage ------------------------------------------------------------------
# sqlite | remote
SS_STORAGE_BACKEND=sqlite
SS_DB_PATH=./data/syllabus_studio.db

# Point at another running instance of this app to share courses across machines
# SS_REMOTE_URL=https://courses.example.com
# SS_REMOTE_TOKEN=

# Community catalog of shareable course bundles (a JSON index; see docs/catalog.md)
SS_CATALOG_URL=

# Server -------------------------------------------------------------------
SS_HOST=127.0.0.1
SS_PORT=8000
SS_RELOAD=true
